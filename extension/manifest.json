{
  "manifest_version": 3,
  "name": "Secure Wallet — Anti-Drain Protection",
  "version": "1.0.0",
  "description": "The only EVM wallet where seed phrase leaks DON'T mean total loss. 8-layer on-chain security + real-time scam detection + transaction preview before signing. Protect your crypto on Ethereum, Base, Optimism, Arbitrum, Polygon, BNB Chain.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/inject.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/provider.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/provider.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
